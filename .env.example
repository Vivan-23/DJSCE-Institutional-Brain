# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- LLM ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- JWT Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_strong_random_secret_key_here

# --- Databases (match docker-compose.yml) ---
DATABASE_URL=postgresql://djsce_brain_user:brain_secure_pass@localhost:5432/djsce_brain_db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=brain_graph_pass
CHROMA_HOST=localhost
CHROMA_PORT=8000
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# Comma-separated list of allowed origins for the API
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8001
